# Vantis Cards — environment
# In production the systemd unit loads, in order:
#   1. ~/.openclaw/secrets/exa.env   (EXA_API_KEY → web enrichment)
#   2. this file                     (inference route + OAuth apps + config)

VANTIS_CARD_PORT=8240
PUBLIC_BASE_URL=https://card.vantis.sh

# Cap on max_tokens per proxied call
VANTIS_CARD_MAX_TOKENS=32768

# ── OAuth apps (register per provider; callbacks must match exactly) ──
# X / Twitter (developer.x.com — OAuth 2.0, callback https://card.vantis.sh/oauth/twitter/callback)
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# TWITTER_REDIRECT_URI defaults to $PUBLIC_BASE_URL/oauth/twitter/callback

# GitHub (github.com/settings/developers — callback https://card.vantis.sh/oauth/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# LinkedIn (linkedin.com/developers — callback https://card.vantis.sh/oauth/linkedin/callback, 1-5 day review)
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# ── Inference route: the rail serves ONE model, deepseek-v4-flash-0731 ──
# Primary — Jatevo pooled route. The bare model id is required for provider
# rotation; a provider-prefixed id pins one diagnostic lane instead.
JATEVO_API_KEY=
JATEVO_BASE_URL=https://api.jatevo.ai/v1
JATEVO_MODEL=DeepSeek-V4-Flash-0731

# Optional direct alternative — DeepSeek first-party, serves 0731 itself:
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash-0731

# Independent failover — BytePlus ModelArk. It ships the 31 July build as the
# GA id below (the plain deepseek-v4-flash-0731 id 404s there).
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL=deepseek-v4-flash-ga-260731

# Standalone fallback if the fleet secret file is absent:
# EXA_API_KEY=

# ── Admin console (card.vantis.sh/admin) ──
# Both halves are required to sign in; the email is never rendered into the page.
VANTIS_CARD_ADMIN_EMAIL=
VANTIS_CARD_ADMIN_TOKEN=
# Stable signing secret so sessions survive a restart (openssl rand -hex 32)
VANTIS_CARD_ADMIN_SECRET=

# Per-key default and combined Card safety ceiling. Provider-specific ceilings
# are handled internally by failover and must not be exposed as user TPM caps.
VANTIS_CARD_DEFAULT_RPM=240
UPSTREAM_RPM_LIMIT=500

# Privy — the vantis.sh account layer (same app as /hub). App ID is public;
# the secret enables server-side user fetch. Empty = Privy gate stays dark.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# HMAC secret for visitor session cookies (rotating it signs everyone out)
VANTIS_CARD_SESSION_SECRET=

# Reserve campaign — all tunable, read at call time (restart applies)
CAMPAIGN_REF_BONUS_USD=1
CAMPAIGN_REF_CAP_USD=10
CAMPAIGN_REF_MIN_SCORE=10
CAMPAIGN_TASK_FOLLOW_USD=0.5
CAMPAIGN_TASK_SHARE_USD=0.5
CAMPAIGN_BUDGET_USD=250
VANTIS_X_HANDLE=vantis_ai
CAMPAIGN_MIN_GRANT_SCORE=10
# 1 = /reserve is the front door, full landing parks at /overview
CAMPAIGN_MODE=1

# X public metrics — bearer token from developer.x.com; empty = dark
X_BEARER_TOKEN=
API_KEYS_ENABLED=0

# Wafer route (optional, priority over ARK when set): ZDR-capable DeepSeek
WAFER_API_KEY=
# WAFER_MODEL=DeepSeek-V4-Flash-0731-Fast
# WAFER_REQUIRE_ZDR=1

# Fleet-default daily spend cap (USD) per account; explicit per-user cap overrides. 0 = off.
VANTIS_CARD_DEFAULT_DAILY_CAP=5

# Deck — who may hold PREVIEW Genesis cartridges before the ERC-721 deploys.
# Comma-separated X handles. A preview cartridge draws a real daily token
# allowance against real upstream spend, so this is deliberately narrower than
# the staging flag (which is on several accounts). Ignored once
# GENESIS_SERIES.contract is set — holdings then come from chain.
VANTIS_CARD_DECK_PREVIEW=lucaxyzz

# ── Paid top-ups (see server/topups/) ──
TOPUPS_MODE=staging            # off | staging | all
TOPUP_SANDBOX=1                # mock card checkout (charges nothing) — test rail, allowlisted handles only
TOPUP_TEST_HANDLES=lucaxyzz     # who may use TEST rails (sandbox, Stripe test keys, devnet USDC); TOPUP_TEST_RAILS_FOR_STAGING=1 widens to staging=1
TOPUP_MIN_USD=5
TOPUP_MAX_USD=500
TOPUP_PRESETS=5,10,25,50,100
TOPUP_AUTO_CAP_USD=100         # a paid top-up lifts the daily spend cap to at least the amount, up to this
STRIPE_SECRET_KEY=             # sk_test_… / sk_live_…  (Stripe hosted Checkout, mode=payment)
STRIPE_WEBHOOK_SECRET=         # whsec_… for POST /webhooks/stripe (checkout.session.completed etc.)
SOLANA_CLUSTER=devnet          # devnet | mainnet-beta
SOLANA_TREASURY_ADDRESS=       # receiving owner address (server holds no key)
SOLANA_USDC_MINT=              # empty = cluster default USDC mint
SOLANA_RPC_URLS=               # comma ladder; empty = cluster defaults
SOLANA_SPONSOR_SECRET=         # base58 32-byte seed of the fee-sponsor key (pays network fees so payers only need USDC); NOT the treasury
SOLANA_SPONSOR_MIN_SOL=0.01    # below this balance sponsorship switches off (payer pays)
EVM_TREASURY_ADDRESS=          # receiving EOA on every EVM chain (server holds no key)
EVM_CHAINS=base,arbitrum,robinhood   # + base-sepolia, arbitrum-sepolia (test rails, allowlisted handles)
TOPUP_EVM_WATCH_SEC=20         # Transfer-log watcher cadence while rows are open
EVM_RELAYER_KEY=               # 0x… private key of the gas RELAYER for EIP-3009 gasless (holds a little ETH per chain; never the treasury)
EVM_RELAYER_MIN_ETH=0.0005     # below this on a chain, gasless switches off there (payer's wallet sends instead)
