# Vantis Cards — environment
# In production the systemd unit loads, in order:
#   1. ~/.openclaw/secrets/exa.env   (EXA_API_KEY → web enrichment)
#   2. this file                     (inference route + OAuth apps + config)

VANTIS_CARD_PORT=8240
PUBLIC_BASE_URL=https://card.vantis.sh

# Cap on max_tokens per proxied call
VANTIS_CARD_MAX_TOKENS=8192

# ── OAuth apps (register per provider; callbacks must match exactly) ──
# X / Twitter (developer.x.com — OAuth 2.0, callback https://card.vantis.sh/oauth/twitter/callback)
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# TWITTER_REDIRECT_URI defaults to $PUBLIC_BASE_URL/oauth/twitter/callback

# GitHub (github.com/settings/developers — callback https://card.vantis.sh/oauth/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# LinkedIn (linkedin.com/developers — callback https://card.vantis.sh/oauth/linkedin/callback, 1-5 day review)
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# ── Inference route: the rail serves ONE model, deepseek-v4-flash-0731 ──
# Priority 1 — DeepSeek first-party, serves 0731 itself:
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash-0731

# Priority 2 — BytePlus ModelArk. It ships the 31 July build as the GA id below
# (the plain deepseek-v4-flash-0731 id 404s there). 500 RPM account quota.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL=deepseek-v4-flash-ga-260731

# Standalone fallback if the fleet secret file is absent:
# EXA_API_KEY=

# ── Admin console (card.vantis.sh/admin) ──
# Both halves are required to sign in; the email is never rendered into the page.
VANTIS_CARD_ADMIN_EMAIL=
VANTIS_CARD_ADMIN_TOKEN=
# Stable signing secret so sessions survive a restart (openssl rand -hex 32)
VANTIS_CARD_ADMIN_SECRET=

# Shared upstream ceiling the gateway sheds at (provider quota, default 500)
UPSTREAM_RPM_LIMIT=500

# Privy — the vantis.sh account layer (same app as /hub). App ID is public;
# the secret enables server-side user fetch. Empty = Privy gate stays dark.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# HMAC secret for visitor session cookies (rotating it signs everyone out)
VANTIS_CARD_SESSION_SECRET=
